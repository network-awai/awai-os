(ns itonami-chat.voice (:require [clojure.string :as str]))
(def uuid #"[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}")
(def duration-ms 180000)
(def max-turns 12)
(defn- matches? [pattern x] (and (string? x) (boolean (re-matches pattern x))))
(defn scope? [x]
 (and (map? x) (= #{:botId :sessionId} (set (keys x)))
      (matches? #"profile:[\w.-]+" (:botId x)) (matches? uuid (:sessionId x))))
(defn open [frame]
 (when (and (map? frame) (= #{:schema :type :scope :durationMs :maxTurns} (set (keys frame)))
            (= "awai.bot-voice-open.v1" (:schema frame)) (= "open" (:type frame))
            (scope? (:scope frame)) (= duration-ms (:durationMs frame)) (= max-turns (:maxTurns frame)))
  {:scope (:scope frame) :turns 0 :seen []}))
(defn admit-turn [state frame elapsed-ms]
 (when (and (map? state) (= #{:scope :turns :seen} (set (keys state)))
            (scope? (:scope state)) (integer? (:turns state)) (<= 0 (:turns state)) (< (:turns state) max-turns)
            (vector? (:seen state)) (= (:turns state) (count (:seen state)))
            (every? #(matches? uuid %) (:seen state)) (= (count (:seen state)) (count (set (:seen state))))
            (integer? elapsed-ms) (<= 0 elapsed-ms) (< elapsed-ms duration-ms)
            (map? frame) (= #{:schema :type :requestId :text} (set (keys frame)))
            (= "awai.bot-voice-frame.v1" (:schema frame)) (= "turn" (:type frame))
            (matches? uuid (:requestId frame)) (not (some #{(:requestId frame)} (:seen state)))
            (string? (:text frame)) (not (str/blank? (:text frame))) (<= (count (:text frame)) 8192))
  {:state (-> state (update :turns inc) (update :seen conj (:requestId frame)))
   :request (merge (:scope state) {:schema "awai.bot-chat-request.v1" :requestId (:requestId frame)
                                 :text (:text frame) :model "muse-spark-1.3"})}))

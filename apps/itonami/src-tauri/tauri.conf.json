{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "Itonami",
  "version": "0.1.0",
  "identifier": "network.itonami.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Itonami",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; connect-src ipc: http://ipc.localhost; form-action 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}

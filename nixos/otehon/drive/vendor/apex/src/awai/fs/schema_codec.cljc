(ns awai.fs.schema-codec
  "Schema-driven codec generator: compile a logical field list once,
  encode/decode canonical DAG-CBOR maps and entry arrays (AWAI-236,
  Form generator unit).

  The schema is the Form: field keywords, wire key strings, and value
  types. `compile-schema` validates field names and types, converts keys
  to UTF-8 bytes, and sorts them into canonical (length-first, bytewise)
  order — spec order never leaks into the wire. The compiled table then
  encodes and decodes with the same refusal contract as the hand-written
  P1 codec, so generated bytes stay oracle-identical."
  )

(def ^:private wire-types #{:uint :bool})

(defn- fail!
  [type message data]
  (throw (ex-info message (assoc data :type type))))

(defn- key-bytes
  "ASCII key string to UTF-8 byte vector. Non-ASCII keys are refused:
  wire keys are fixed protocol tokens, never free text."
  [k]
  (when-not (and (string? k) (pos? (count k)))
    (fail! :awai.fs.schema/bad-key "awai fs schema: key must be a non-empty string" {:key k}))
  (let [bs (mapv (fn [i] #?(:clj (int (.charAt ^String k (int i)))
                            :cljs (.charCodeAt k i)))
                 (range (count k)))]
    (when (some #(> % 127) bs)
      (fail! :awai.fs.schema/non-ascii-key "awai fs schema: wire keys must be ASCII" {:key k}))
    bs))

(defn compile-schema
  "Compile {:kind :map :name name :fields [[kw key type] ...]} to a codec
  {:name :table [[kw key-bytes type] ...]} in canonical key order.
  Refuses bad kinds, empty fields, non-keyword fields, duplicate keys,
  and unknown types — all at compile time, never at first encode."
  [{:keys [kind name fields] :as spec}]
  (when-not (= :map kind)
    (fail! :awai.fs.schema/bad-kind "awai fs schema: only :map schemas are supported" {:kind kind}))
  (when-not (and (sequential? fields) (seq fields))
    (fail! :awai.fs.schema/empty-fields "awai fs schema: fields must be non-empty" {:name name}))
  (let [rows (mapv (fn [[kw k t]]
                     (when-not (keyword? kw)
                       (fail! :awai.fs.schema/bad-key "awai fs schema: field must be a keyword" {:field kw}))
                     (when-not (contains? wire-types t)
                       (fail! :awai.fs.schema/unknown-type "awai fs schema: unknown value type"
                              {:field kw :type t}))
                     [kw (key-bytes k) t])
                   fields)
        kws (mapv first rows)
        kbs (mapv second rows)]
    (when (not= (count kws) (count (distinct kws)))
      (fail! :awai.fs.schema/duplicate-key "awai fs schema: duplicate field" {:name name}))
    (when (not= (count kbs) (count (distinct kbs)))
      (fail! :awai.fs.schema/duplicate-key "awai fs schema: duplicate wire key" {:name name}))
    {:name name
     :table (sort-by (juxt (comp count second) second) rows)}))

(defn- uint-head
  "Shortest-form head bytes for non-negative integer n."
  [n]
  (cond
    (< n 24) [n]
    (< n 256) [0x18 n]
    (< n 65536) [0x19 (bit-and (bit-shift-right n 8) 0xff) (bit-and n 0xff)]
    (< n 4294967296) [0x1a
                      (bit-and (bit-shift-right n 24) 0xff)
                      (bit-and (bit-shift-right n 16) 0xff)
                      (bit-and (bit-shift-right n 8) 0xff)
                      (bit-and n 0xff)]
    :else [0x1b
           (bit-and (bit-shift-right n 56) 0xff)
           (bit-and (bit-shift-right n 48) 0xff)
           (bit-and (bit-shift-right n 40) 0xff)
           (bit-and (bit-shift-right n 32) 0xff)
           (bit-and (bit-shift-right n 24) 0xff)
           (bit-and (bit-shift-right n 16) 0xff)
           (bit-and (bit-shift-right n 8) 0xff)
           (bit-and n 0xff)]))

(defn- head
  "Shortest-form head bytes for major with value n."
  [major n]
  (let [h (uint-head n)]
    (into [(bit-or (bit-shift-left major 5) (bit-and (first h) 0x1f))] (rest h))))

(defn- encode-value
  "Encode a value by table type: uint or bool (0xf4/0xf5)."
  [v t kind k]
  (case t
    :uint (do
            (when-not (and (integer? v) (not (neg? v)))
              (fail! :awai.fs.codec/bad-value "awai fs codec: value must be a non-negative integer"
                     {:kind kind :key k :value v}))
            (uint-head v))
    :bool (do
            (when-not (boolean? v)
              (fail! :awai.fs.codec/bad-value "awai fs codec: value must be a boolean"
                     {:kind kind :key k :value v}))
            [(if v 0xf5 0xf4)])))

(defn- check-value
  "Validate a decoded value against its table type."
  [v t kind k]
  (case t
    :uint (if (and (integer? v) (not (neg? v)))
            v
            (fail! :awai.fs.codec/bad-value "awai fs codec: value must be a non-negative integer"
                   {:kind kind :key k :value v}))
    :bool (if (boolean? v)
            v
            (fail! :awai.fs.codec/bad-value "awai fs codec: value must be a boolean"
                   {:kind kind :key k :value v}))))

(defn encode
  "Encode map `m` with the compiled table's key order."
  [{:keys [table] :as codec} m]
  (let [want (mapv first table)
        have (set (keys m))]
    (doseq [k want]
      (when-not (contains? have k)
        (fail! :awai.fs.codec/missing-key "awai fs codec: missing key" {:kind (:name codec) :key k})))
    (doseq [k (keys m)]
      (when-not (contains? (set want) k)
        (fail! :awai.fs.codec/unknown-key "awai fs codec: unknown key" {:kind (:name codec) :key k})))
    (into (head 5 (count table))
          (mapcat (fn [[k kb t]]
                    (concat [(+ 0x60 (count kb))] kb (encode-value (get m k) t (:name codec) k)))
                  table))))

(defn- read-head
  "Read one head at pos. Returns [major n pos-after]. Refuses indefinite
  lengths and truncated input."
  [bytes pos]
  (when (>= pos (count bytes))
    (fail! :awai.fs.codec/truncated "awai fs codec: truncated input" {:pos pos}))
  (let [b (nth bytes pos)
        major (bit-shift-right b 5)
        ai (bit-and b 0x1f)]
    (when (= ai 31)
      (fail! :awai.fs.codec/indefinite-length "awai fs codec: indefinite length forbidden" {:pos pos}))
    (cond
      (< ai 24) [major ai (inc pos)]
      (= ai 24) (if (< (inc pos) (count bytes))
                  [major (nth bytes (inc pos)) (+ pos 2)]
                  (fail! :awai.fs.codec/truncated "awai fs codec: truncated input" {:pos pos}))
      (= ai 25) (if (< (+ pos 2) (count bytes))
                  [major (+ (* 256 (nth bytes (inc pos))) (nth bytes (+ pos 2))) (+ pos 3)]
                  (fail! :awai.fs.codec/truncated "awai fs codec: truncated input" {:pos pos}))
      (= ai 26) (if (< (+ pos 4) (count bytes))
                  [major (reduce (fn [acc i] (+ (* acc 256) (nth bytes (+ pos 1 i)))) 0 (range 4)) (+ pos 5)]
                  (fail! :awai.fs.codec/truncated "awai fs codec: truncated input" {:pos pos}))
      :else (if (< (+ pos 8) (count bytes))
              [major (reduce (fn [acc i] (+ (* acc 256) (nth bytes (+ pos 1 i)))) 0 (range 8)) (+ pos 9)]
              (fail! :awai.fs.codec/truncated "awai fs codec: truncated input" {:pos pos})))))

(defn- read-value
  "Read one canonical value head: uint (major 0) or bool (0xf4/0xf5)."
  [bytes pos]
  (let [[major n p] (read-head bytes pos)]
    (cond
      (= major 0) [n p]
      (and (= major 7) (= n 20)) [false p]
      (and (= major 7) (= n 21)) [true p]
      :else (fail! :awai.fs.codec/bad-value "awai fs codec: value must be a uint or bool"
                   {:pos pos :major major}))))

(defn- read-map-pairs
  "Read n text->value pairs. Returns [pairs end-pos]."
  [bytes pos n]
  (loop [p pos i 0 out []]
    (if (= i n)
      [out p]
      (let [[km kn p2] (read-head bytes p)]
        (when (not= km 3)
          (fail! :awai.fs.codec/not-a-text-key "awai fs codec: map key must be text" {:pos p}))
        (let [kb (subvec (vec bytes) p2 (+ p2 kn))
              [v p3] (read-value bytes (+ p2 kn))]
          (recur p3 (inc i) (conj out [kb v])))))))

(defn decode
  "Decode canonical map bytes with the compiled table: exact key set,
  canonical order, typed values, no trailing bytes."
  [{:keys [table name]} raw]
  (let [bytes (vec raw)]
    (when (empty? bytes)
      (fail! :awai.fs.codec/truncated "awai fs codec: truncated input" {:pos 0}))
    (let [[major n pos] (read-head bytes 0)]
      (when (not= major 5)
        (fail! :awai.fs.codec/not-a-map "awai fs codec: input is not a map" {:major major}))
      (when (not= n (count table))
        (fail! :awai.fs.codec/bad-pair-count "awai fs codec: wrong pair count" {:n n}))
      (let [[pairs end] (read-map-pairs bytes pos n)]
        (when (< end (count bytes))
          (fail! :awai.fs.codec/trailing-bytes "awai fs codec: trailing bytes" {:pos end}))
        (let [got (mapv first pairs)
              want (mapv second table)]
          (doseq [kb got]
            (when-not (some #(= % kb) want)
              (fail! :awai.fs.codec/unknown-key "awai fs codec: unknown key" {:key kb})))
          (when (not= got want)
            (fail! :awai.fs.codec/bad-key-order "awai fs codec: keys out of canonical order" {}))
          (into {} (map (fn [[_ v] [k _ t]] [k (check-value v t name k)]) pairs table)))))))

(defn encode-entries
  "Encode a sequential of entry maps to a canonical array with the
  compiled entry table. Order is the caller's invariant, preserved."
  [codec entries]
  (when-not (sequential? entries)
    (fail! :awai.fs.codec/not-an-array "awai fs codec: entries must be sequential" {}))
  (into (head 4 (count entries))
        (mapcat (fn [e]
                  (when-not (map? e)
                    (fail! :awai.fs.codec/not-a-map "awai fs codec: entry must be a map" {:entry e}))
                  (encode codec e))
                entries)))

(defn decode-entries
  "Decode a canonical entries array with the compiled entry table."
  [{:keys [table name] :as codec} raw]
  (let [bytes (vec raw)]
    (when (empty? bytes)
      (fail! :awai.fs.codec/truncated "awai fs codec: truncated input" {:pos 0}))
    (let [[major n pos] (read-head bytes 0)]
      (when (not= major 4)
        (fail! :awai.fs.codec/not-an-array "awai fs codec: input is not an array" {:major major}))
      (loop [p pos i 0 out []]
        (if (= i n)
          (do
            (when (< p (count bytes))
              (fail! :awai.fs.codec/trailing-bytes "awai fs codec: trailing bytes" {:pos p}))
            out)
          (let [[em en p2] (read-head bytes p)]
            (when (not= em 5)
              (fail! :awai.fs.codec/not-a-map "awai fs codec: entry must be a map" {:index i}))
            (when (not= en (count table))
              (fail! :awai.fs.codec/bad-pair-count "awai fs codec: wrong entry pair count"
                     {:index i :n en}))
            (let [[pairs p3] (read-map-pairs bytes p2 en)
                  got (mapv first pairs)
                  want (mapv second table)]
              (doseq [kb got]
                (when-not (some #(= % kb) want)
                  (fail! :awai.fs.codec/unknown-key "awai fs codec: unknown key" {:index i :key kb})))
              (when (not= got want)
                (fail! :awai.fs.codec/bad-key-order "awai fs codec: keys out of canonical order"
                       {:index i}))
              (recur p3 (inc i) (conj out (into {} (map (fn [[_ v] [k _ t]]
                                                          [k (check-value v t name k)])
                                                        pairs table)))))))))))

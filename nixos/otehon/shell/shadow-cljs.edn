{:source-paths ["src" "link" "vendor" "styles"]
 :builds {:reliability {:target :browser
                        :output-dir "dist/assets"
                        :asset-path "../assets"
                        :compiler-options {:externs ["externs/otehon-shell.js"]}
                        :modules {:fs-reliability {:init-fn shell.reliability/init}}}
          :shell {:target :browser
                  :output-dir "dist/assets"
                  :asset-path "assets"
                  :compiler-options {:externs ["externs/otehon-shell.js"]}
                  :modules {:main {:init-fn shell.main/init}}}
          :link {:target :browser
                 :output-dir "dist/link/assets"
                 :asset-path "assets"
                 :compiler-options {:externs ["externs/otehon-shell.js"]}
                 :modules {:main {:init-fn link.main/init}}}}}

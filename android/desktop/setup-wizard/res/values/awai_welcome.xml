<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="awai_welcome_name" translatable="false">Awai OS</string>
    <string name="awai_welcome_release" translatable="false">Awai OS Meiji</string>
    <string name="awai_welcome_description">Let\'s set up this device.</string>
    <string name="awai_welcome_setup_heading">Device setup</string>
    <string name="awai_welcome_language_label">Change language</string>
    <string name="awai_welcome_accessibility">Accessibility</string>
    <string name="awai_welcome_start">Start</string>

    <!-- AWAI-3563 PC SetupWizard wording (wide screens only; see res/values/awai_welcome.xml usage in patch). -->
    <string name="awai_intro_restore_subtitle">If you have a Seedvault backup from Awai OS or any other OS, you can restore it here.</string>
    <string name="awai_setup_services">Awai OS features</string>
    <string name="awai_services_help_improve">Help improve <xliff:g id="name" example="Awai OS">%s</xliff:g></string>
    <string name="awai_services_metrics_label"><xliff:g id="name" example="Help improve Awai OS">%1$s</xliff:g> by sharing diagnostic and usage data with <xliff:g id="name" example="Awai OS">%2$s</xliff:g>. This is off by default. If you turn it on, <xliff:g id="name" example="Awai OS">%2$s</xliff:g> will send diagnostic and usage data. This information can’t be used to identify you and lends a hand to teams working on things like battery life, app performance, and new <xliff:g id="name" example="Awai OS">%3$s</xliff:g> features.</string>
    <string name="awai_screen_lock_title">Protect this PC</string>

    <color name="awai_welcome_ink">#13233D</color>
    <color name="awai_welcome_focus">#4B7BD1</color>
    <dimen name="awai_welcome_brand_bottom">48dp</dimen>
    <dimen name="awai_welcome_gutter">32dp</dimen>
    <dimen name="awai_welcome_gap">32dp</dimen>
    <dimen name="awai_welcome_logo_size">112dp</dimen>
    <dimen name="awai_welcome_title_size">36sp</dimen>
    <dimen name="awai_welcome_panel_padding">24dp</dimen>

    <style name="AwaiWelcome" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/awai_welcome_ink</item>
    </style>
    <style name="AwaiWelcome.Brand">
        <item name="android:textColor">#315681</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AwaiWelcome.Title">
        <item name="android:textSize">@dimen/awai_welcome_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AwaiWelcome.Description">
        <item name="android:textColor">#344B68</item>
        <item name="android:textSize">25sp</item>
    </style>
    <style name="AwaiWelcome.PanelTitle">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AwaiWelcome.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="AwaiWelcome.Option" parent="AwaiWelcome.Button">
        <item name="android:background">@drawable/awai_welcome_option</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
    <style name="AwaiWelcome.Start" parent="AwaiWelcome.Button">
        <item name="android:background">@drawable/awai_welcome_start</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

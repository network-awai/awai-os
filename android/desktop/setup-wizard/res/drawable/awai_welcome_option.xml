<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33628CC9">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="#EDF2F8" />
                    <stroke android:width="4dp" android:color="@color/awai_welcome_focus" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#EDF2F8" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

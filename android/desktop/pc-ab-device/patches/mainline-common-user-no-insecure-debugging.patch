 void vendor_process_bootenv_mainline_common(void) {
+#ifdef AWAI_ALLOW_INSECURE_DEBUGGING
+    // AWAI-3682: only debuggable builds (userdebug, eng) honour these switches.
+    // A user build ignores both, so neither the kernel command line nor a file
+    // on /metadata can turn off ADB authentication or set ro.debuggable.
     if (access("/metadata/.enable_insecure_debugging", F_OK) == 0 ||
         GetBoolProperty("ro.boot.insecure_adb", false)) {
         enable_insecure_debugging();
     }
+#endif
 }
 

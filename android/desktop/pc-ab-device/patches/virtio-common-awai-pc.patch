diff --git a/configs/kernel/awai-pc.config b/configs/kernel/awai-pc.config
new file mode 100644
index 0000000..00fdfb2
--- /dev/null
+++ b/configs/kernel/awai-pc.config
@@ -0,0 +1,18 @@
+# AWAI-3586: drivers for real PC hardware (7735HS Desktop first). Built in unless noted.
+# Ethernet: Realtek RTL8168/8111 (the Desktop's NIC) and common Intel NICs
+CONFIG_R8169=y
+CONFIG_REALTEK_PHY=y
+CONFIG_E1000E=y
+CONFIG_IGC=y
+# Console text on the firmware framebuffer. Not simpledrm: as DRM card 0 it makes SurfaceFlinger abort
+# ("No matching frame rate modes"), also in the headless mode.
+CONFIG_FB_EFI=y
+# AMD GPU (Radeon 680M). A module: it needs firmware files, and is not loaded automatically yet.
+CONFIG_DRM_AMDGPU=m
+CONFIG_DRM_AMD_DC=y
+CONFIG_HSA_AMD=n
+# AMD platform
+CONFIG_PINCTRL_AMD=y
+CONFIG_I2C_PIIX4=y
+CONFIG_SENSORS_K10TEMP=m
+CONFIG_SND_HDA_CODEC_HDMI=y

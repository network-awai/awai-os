@@ -50,0 +52,15 @@ class UserPreferencesRepository(context: Context) {
+    val automaticPcMaintenanceFlow = userPreferencesFlow.map { preferences ->
+        preferences[UserPreferencesKeys.AUTOMATIC_PC_MAINTENANCE] ?: false
+    }
+
+    suspend fun canRunAutomaticPcMaintenance(): Boolean = userPreferencesFlow.map {
+        it[UserPreferencesKeys.AUTOMATIC_PC_MAINTENANCE] == true &&
+                it[UserPreferencesKeys.PERIODIC_CHECK_ENABLED] != false &&
+                it[UserPreferencesKeys.STREAM_UPDATES] != false
+    }.first()
+
+    suspend fun setAutomaticPcMaintenance(enabled: Boolean) {
+        userPreferences.edit { it[UserPreferencesKeys.AUTOMATIC_PC_MAINTENANCE] = enabled }
+        UpdatesCheckWorker.reschedulePeriodicCheck(appContext)
+    }
+

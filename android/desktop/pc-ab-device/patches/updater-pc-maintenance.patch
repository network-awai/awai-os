index 0000000..7ef4c50
--- /dev/null
+++ b/app/src/main/java/org/lineageos/updater/controller/PcMaintenance.kt
@@ -0,0 +1,107 @@
+/*
+ * SPDX-FileCopyrightText: The Awai Network Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.updater.controller
+
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.net.ConnectivityManager
+import android.net.NetworkCapabilities
+import android.os.BatteryManager
+import android.os.PowerManager
+import android.provider.Settings
+import androidx.preference.PreferenceManager
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import org.lineageos.updater.UpdaterApplication
+import org.lineageos.updater.data.Update
+import org.lineageos.updater.deviceinfo.DeviceInfoUtils
+import org.lineageos.updater.util.InstallUtils
+import java.net.URI
+
+object PcMaintenance {
+    // This preference identifies only payloads handed to UpdateEngine by the maintenance worker.
+    internal const val OWNED_UPDATE = "automatic_pc_maintenance_id"
+
+    val isSupported: Boolean
+        get() = DeviceInfoUtils.isABDevice && DeviceInfoUtils.device == "virtio_x86_64"
+
+    internal fun isAwaiPackage(url: String?): Boolean {
+        val uri = url?.let { runCatching { URI(it) }.getOrNull() } ?: return false
+        return uri.scheme == "https" && uri.host == "ota.awai.network" &&
+                (uri.port == -1 || uri.port == 443) && uri.userInfo == null &&
+                uri.rawQuery == null && uri.rawFragment == null &&
+                uri.rawPath.startsWith("/v1/pc/pilot/") &&
+                !uri.rawPath.contains('%') && uri.normalize().rawPath == uri.rawPath
+    }
+
+    private fun canMaintain(context: Context): Boolean {
+        val power = context.getSystemService(PowerManager::class.java) ?: return false
+        if (power.isInteractive || Settings.Global.getInt(
+                context.contentResolver, Settings.Global.DEVICE_PROVISIONED, 0,
+            ) != 1 || Settings.Secure.getInt(context.contentResolver, "user_setup_complete", 0) != 1
+        ) return false
+
+        val network = context.getSystemService(ConnectivityManager::class.java) ?: return false
+        val capabilities = network.getNetworkCapabilities(network.activeNetwork) ?: return false
+        if (!capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED) ||
+            !capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED) ||
+            network.isActiveNetworkMetered
+        ) return false
+
+        val battery = context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+            ?: return false
+        return battery.hasExtra(BatteryManager.EXTRA_PRESENT) &&
+                (!battery.getBooleanExtra(BatteryManager.EXTRA_PRESENT, true) ||
+                        battery.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0)
+    }
+
+    internal suspend fun run(
+        application: UpdaterApplication,
+        offers: List<Update>,
+        allowNewUpdate: Boolean = true,
+    ): Boolean = withContext(Dispatchers.IO) {
+        val prefs = application.userPreferencesRepository
+        if (!isSupported || !prefs.canRunAutomaticPcMaintenance()) return@withContext false
+
+        val storage = PreferenceManager.getDefaultSharedPreferences(application)
+        val owned = storage.getString(OWNED_UPDATE, null)
+        val inProgress = owned != null && ABUpdateInstaller.isInstallingUpdate(application, owned)
+        if (!canMaintain(application)) return@withContext inProgress
+        if (!inProgress && (!allowNewUpdate || offers.isEmpty())) return@withContext false
+
+        val approved = offers.filter {
+            it.timestamp > DeviceInfoUtils.buildDateTimestamp &&
+                    isAwaiPackage(it.downloadUrl) &&
+                    InstallUtils.canInstall(it) && InstallUtils.canStreamUpdate(it, true) &&
+                    it.payloadPropertiesSize in 1L..65_536L
+        }
+
+        val context = currentCoroutineContext()
+        val stillAllowed = {
+            context.ensureActive()
+            runBlocking { prefs.canRunAutomaticPcMaintenance() } && canMaintain(application)
+        }
+        val controller = UpdaterController.getInstance(application)
+        val installer = ABUpdateInstaller.getInstance(application, controller, prefs)
+        if (owned != null && inProgress) {
+            if (!ABUpdateInstaller.isWaitingForReboot(application, owned)) {
+                installer.reconnect()
+                return@withContext true
+            }
+            return@withContext approved.any { it.downloadId == owned } &&
+                    !installer.rebootAutomaticUpdate(owned, stillAllowed)
+        }
+
+        val update = approved.maxByOrNull { it.timestamp } ?: return@withContext false
+        if (!controller.isBusy) {
+            installer.installAutomaticStreaming(update, stillAllowed)
+        }
+        false
+    }
+}

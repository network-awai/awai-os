; established by this cell.
(in-package "ACL2")

(defun ref-name-p (x)
  (declare (xargs :mode :program))
  (member-eq x '(inc1)))

(mutual-recursion
 (defun dg (x)
   (declare (xargs :mode :program))
   (cond ((atom x) x)
         ((eq (car x) 'defn)
          (list 'defn (cadr x) (caddr x) (cadddr x) (dg (car (cddddr x)))))
         ((eq (car x) '->)
          (dg (dg-thread (dg (cadr x)) (cddr x))))
         ((eq (car x) '->>)
          (dg (dg-thread-last (dg (cadr x)) (cddr x))))
         ((eq (car x) 'cond) (dg-cond (cdr x)))
         ((eq (car x) 'if-not)
          (list 'if (dg (cadr x)) (dg (cadddr x)) (dg (caddr x))))
         ((eq (car x) 'case)
          (list 'let (list 't (dg (cadr x))) (dg-case-if 't (cddr x))))
         ((and (symbolp (car x)) (ref-name-p (car x)) (consp (cdr x)) (null (cddr x)))
          (list 'app (list 'ref (car x)) (dg (cadr x))))
         (t (cons (car x) (dg-list (cdr x))))))
 (defun dg-list (xs)
   (declare (xargs :mode :program))
   (if (atom xs) nil (cons (dg (car xs)) (dg-list (cdr xs)))))
 (defun dg-thread (acc steps)
   (declare (xargs :mode :program))
   (if (atom steps) acc (dg-thread (thread-apply acc (car steps)) (cdr steps))))
 (defun thread-apply (acc s)
   (declare (xargs :mode :program))
   (if (atom s) (list s acc) (cons (car s) (cons acc (dg-list (cdr s))))))
 (defun dg-thread-last (acc steps)
   (declare (xargs :mode :program))
   (if (atom steps) acc (dg-thread-last (thread-apply-last acc (car steps)) (cdr steps))))
 (defun thread-apply-last (acc s)
   (declare (xargs :mode :program))
   (if (atom s) (list s acc) (append (dg-list s) (list acc))))
 (defun dg-cond (clauses)
   (declare (xargs :mode :program))
   (cond ((atom clauses) nil)
         ((eq (car clauses) :else) (dg (cadr clauses)))
         (t (list 'if (dg (car clauses)) (dg (cadr clauses)) (dg-cond (cddr clauses))))))
 (defun dg-case-if (v rest)
   (declare (xargs :mode :program))
   (cond ((atom (cdr rest)) (dg (car rest)))
         (t (list 'if (list '= v (dg (car rest))) (dg (cadr rest)) (dg-case-if v (cddr rest)))))))

(defun dg-forms (xs)
  (declare (xargs :mode :program))
  (if (atom xs) nil (cons (dg (car xs)) (dg-forms (cdr xs)))))

(defun results ()
  (declare (xargs :mode :program))
  (list
      (equal (dg '(defn run (n :i64) :i64 (-> n inc1 inc1)))
          '(defn run (n :i64) :i64 (app (ref inc1) (app (ref inc1) n))))
   (equal (dg '(defn run (n :i64) :i64 (cond (< n 0) 0 :else n)))
          '(defn run (n :i64) :i64 (if (< n 0) 0 n)))
   (equal (dg '(defn f (n :i64) :i64 (cond (< n 0) 1 (< n 5) 2 :else 3)))
          '(defn f (n :i64) :i64 (if (< n 0) 1 (if (< n 5) 2 3))))
   (not (equal (dg '(defn f (n :i64) :i64 (cond (< n 0) 1 (< n 5) 9 :else 3)))
               '(defn f (n :i64) :i64 (if (< n 0) 1 (if (< n 5) 2 3)))))
   (equal (dg '(defn f (n :i64) :i64 (if-not (< n 0) 1 2)))
          '(defn f (n :i64) :i64 (if (< n 0) 2 1)))
   (not (equal (dg '(defn f (n :i64) :i64 (if-not (< n 0) 1 3)))
               '(defn f (n :i64) :i64 (if (< n 0) 2 1))))
   (equal (dg-forms '((defn g (x :i64) :i64 (+ x 1)) (defn f (n :i64) :i64 (-> n g g))))
          '((defn g (x :i64) :i64 (+ x 1)) (defn f (n :i64) :i64 (g (g n)))))
   (not (equal (dg-forms '((defn g (x :i64) :i64 (+ x 1)) (defn f (n :i64) :i64 (-> n g))))
               '((defn g (x :i64) :i64 (+ x 1)) (defn f (n :i64) :i64 (g (g n))))))
   (equal (dg '(defn f (n :i64) :i64 (->> n (+ 1) (* 2))))
          '(defn f (n :i64) :i64 (* 2 (+ 1 n))))
   (not (equal (dg '(defn f (n :i64) :i64 (->> n (+ 1) (* 3))))
               '(defn f (n :i64) :i64 (* 2 (+ 1 n)))))
   (equal (dg '(defn f (n :i64) :i64 (case n 0 10 20)))
          '(defn f (n :i64) :i64 (let (t n) (if (= t 0) 10 20))))
   (not (equal (dg '(defn f (n :i64) :i64 (case n 0 11 20)))
               '(defn f (n :i64) :i64 (let (t n) (if (= t 0) 10 20)))))
   (equal (dg '(defn f (n :i64) :i64 (case n 0 10 1 20 30)))
          '(defn f (n :i64) :i64 (let (t n) (if (= t 0) 10 (if (= t 1) 20 30)))))
   (not (equal (dg '(defn f (n :i64) :i64 (case n 0 10 1 21 30)))
               '(defn f (n :i64) :i64 (let (t n) (if (= t 0) 10 (if (= t 1) 20 30))))))))

(results)

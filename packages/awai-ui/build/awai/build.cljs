(ns awai.build (:require ["node:fs" :as fs] ["node:crypto" :as crypto] ["esbuild" :as esbuild]))
(def tokens (js/JSON.parse (fs/readFileSync "tokens/figma-android-v2.json" "utf8")))
(defn colors [theme] (apply str (map (fn [[k v]] (str "--awai-" k ":" (get-in v [theme "hex"]) ";")) (get tokens "colors"))))
(fs/mkdirSync "dist" #js{:recursive true})
(fs/cpSync "assets" "dist/ui-assets" #js{:recursive true})
(def dimensions (get tokens "dimensions"))
(def dim-css (str "--awai-radius-large:" (get dimensions "shape-large") "px;--awai-radius-medium:" (get dimensions "shape-medium") "px;--awai-space:" (get dimensions "space-compact") "px;--awai-target:" (get dimensions "target-min") "px;"))
(def css (str ".awai-ui{" (colors "light") dim-css "}\n@media(prefers-color-scheme:dark){.awai-ui:not([data-awai-theme=light]){" (colors "dark") "}}\n.awai-ui[data-awai-theme=dark]{" (colors "dark") "}\n" (fs/readFileSync "src/awai/ui.css" "utf8")))
(fs/writeFileSync "dist/awai-ui.css" css)
(esbuild/buildSync #js{:entryPoints #js[".build/awai/index.mjs"] :outfile "dist/index.js" :bundle true :format "esm" :platform "browser" :target #js["es2022"] :minify false})
(def hashes (into {} (map (fn [f] [f (-> (crypto/createHash "sha256") (.update (fs/readFileSync f)) (.digest "hex"))]) ["tokens/figma-android-v2.json" "dist/awai-ui.css" "dist/index.js" "src/awai/ui.cljc" "src/awai/dom.cljs" "assets/search.svg" "assets/store.svg" "assets/noto-jp.woff2" "assets/font-OFL.txt" "assets/apps.svg" "assets/download.svg"])))
(fs/writeFileSync "dist/integrity.json" (js/JSON.stringify {:schema "awai.ui.artifact.v1" :version "0.1.0" :files hashes} nil 2))

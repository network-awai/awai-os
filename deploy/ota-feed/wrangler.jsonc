{
  "$schema": "node_modules/wrangler/config-schema.json",
  // awai-ota-feed (ota.awai.network). Deliberately NO object-store bucket binding:
  // the mutable index lives in this repo; payload bytes stay at the
  // commit-pinned raw URL carried inside the index (never proxied here).
  "name": "awai-ota-feed",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "routes": [{ "pattern": "ota.awai.network", "custom_domain": true }],
  "observability": { "enabled": false }
}

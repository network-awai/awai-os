  {"fn": "valid-address?", "args": ["0x01"], "expect": false},
  {"fn": "valid-address?", "args": ["0000000000000000000000000000000000000001"], "expect": false},
  {"fn": "valid-address?", "args": ["0xZZ00000000000000000000000000000000000001"], "expect": false},
  {"fn": "valid-address?", "args": [null], "expect": false},
  {"fn": "hex->decimal", "args": ["0x0"], "expect": "0"},

  {"fn": "hex->decimal", "args": ["0xFF"], "expect": "255"},
  {"fn": "hex->decimal", "args": ["0xde0b6b3a7640000"], "expect": "1000000000000000000"},
  {"fn": "hex->decimal", "args": ["0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"], "expect": "115792089237316195423570985008687907853269984665640564039457584007913129639935"},
  {"fn": "hex->decimal", "args": ["0xnope"], "expect": null},
  {"fn": "hex->decimal", "args": ["255"], "expect": null},
  {"fn": "format-units", "args": ["1000000000000000000", 18], "expect": "1"},
  {"fn": "format-units", "args": ["1500000000000000000", 18], "expect": "1.5"},
  {"fn": "format-units", "args": ["1", 18], "expect": "0.000000000000000001"},
  {"fn": "format-units", "args": ["0", 18], "expect": "0"},
  {"fn": "format-units", "args": ["115792089237316195423570985008687907853269984665640564039457584007913129639935", 18], "expect": "115792089237316195423570985008687907853269984665640564039457.584007913129639935"},
  {"fn": "format-units", "args": ["12.5", 18], "expect": null},
  {"fn": "format-units", "args": ["-1", 18], "expect": null},
  {"fn": "format-units", "args": ["", 18], "expect": null},
  {"fn": "balance-request", "args": ["0xAB00000000000000000000000000000000000001", 7], "expect": {"jsonrpc": "2.0", "id": 7, "method": "eth_getBalance", "params": ["0xab00000000000000000000000000000000000001", "latest"]}},
  {"fn": "balance-request", "args": ["nope", 7], "expect": {"error": "invalid-address"}},
  {"fn": "read-balance", "args": [{"result": "0xde0b6b3a7640000"}, 18], "expect": {"wei": "1000000000000000000", "display": "1"}},
  {"fn": "read-balance", "args": [{"error": {"code": -32000, "message": "no"}}, 18], "expect": {"error": "rpc-error"}},
  {"fn": "read-balance", "args": [{"result": "garbage"}, 18], "expect": {"error": "bad-response"}},
  {"fn": "read-balance", "args": [{}, 18], "expect": {"error": "bad-response"}},
  {"fn": "operation-gate", "args": [50, 50], "expect": {"allowed": true}},
  {"fn": "operation-gate", "args": [10, 50], "expect": {"allowed": false, "needs": 50, "has": 10}}

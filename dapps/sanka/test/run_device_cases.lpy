;; Runs the device cases on Basilisp. usage: PYTHONPATH=src:test basilisp run test/run_device_cases.lpy
(ns run-device-cases
  (:require [sanka.device-runner :as runner])
  (:import json sys))

(defn from-json [value]
  (cond
    (instance? python/dict value) (into {} (map (fn [[k v]] [(keyword k) (from-json v)]) (.items value)))
    (instance? python/list value) (mapv from-json value)
    :else value))

(defn -main []
  (let [result (runner/run (from-json (json/loads (.read (python/open "test/device_cases.json")))))
        failures (:failures result)]
    (doseq [failure failures] (println "FAIL" failure))
    (println "basilisp device checks" (:checks result) "failures" (count failures))
    (sys/exit (if (seq failures) 1 0))))

(-main)
